# Financial Decision Lab (FDL) Environment Variables

# Backend API Configuration
PORT=8000
API_HOST=127.0.0.1
DATABASE_URL=sqlite:///./fdl.db

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
FASTAPI_INTERNAL_URL=http://127.0.0.1:8000

# Authentication & Security Gateway
AUTH_SECRET=fdl-super-secret-auth-key-minimum-32-chars-long!
INTERNAL_SERVICE_KEY=fdl-internal-shared-secret-key-min32-chars-xyz

# AI / ML Configuration
# Predictions & calculations run on local deterministic engine + custom models.
# For fast optional phrasing/NLU, Groq or local Ollama can be used.
PRIVACY_MODE=local # "local" | "hybrid" | "off"
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
