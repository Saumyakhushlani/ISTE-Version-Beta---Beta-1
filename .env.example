# Financial Decision Lab (FDL) Environment Variables

# Backend API Configuration
PORT=8000
API_HOST=127.0.0.1
DATABASE_URL=sqlite:///./fdl.db

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI / ML Configuration
# Predictions & calculations run on local deterministic engine + custom models.
# For fast optional phrasing/NLU, Groq or local Ollama can be used.
PRIVACY_MODE=local # "local" | "hybrid" | "off"
GROQ_API_KEY=gsk_your_groq_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
